# Unreal generated output
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Build/*/FileOpenOrder/

# Generated output inside project plugins
/Plugins/**/Binaries/
/Plugins/**/Intermediate/

# IDE and local user state
/.idea/
/.vs/
**/__pycache__/
*.py[cod]
*.DotSettings.user
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Per-user Unreal content
/Content/Developers/
/Content/Collections/

# The Unreal project lives in ScrollPeddler/, so the rules above need the subfolder prefix too
/ScrollPeddler/Binaries/
/ScrollPeddler/DerivedDataCache/
/ScrollPeddler/Intermediate/
/ScrollPeddler/Saved/
/ScrollPeddler/Build/*/FileOpenOrder/
/ScrollPeddler/Plugins/**/Binaries/
/ScrollPeddler/Plugins/**/Intermediate/
/ScrollPeddler/.idea/
/ScrollPeddler/.vs/
/ScrollPeddler/Content/Developers/
/ScrollPeddler/Content/Collections/
/ScrollPeddler/Builds/
/ScrollPeddler/LocalTestEvidence/
*.user

# Local OS files
.DS_Store
Thumbs.db
Desktop.ini
